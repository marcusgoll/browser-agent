# Browser Agent Configuration
# Copy to .env and fill in your keys

# LLM Provider: openrouter | anthropic | openai | custom
# For custom, set LLM_BASE_URL and LLM_API_KEY to an OpenAI-compatible endpoint.
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-sonnet-4
LLM_BASE_URL=
LLM_API_KEY=

# API Keys (at least one required, depending on provider)
OPENROUTER_API_KEY=sk-or-v1-...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Chrome Connection (optional — uses existing browserless/chrome)
# Leave empty to use local Playwright browser
CHROME_HOST=
CHROME_PORT=9222

# X bookmark approved-execute support
# Required only when moving/deleting X bookmarks through the approved execute wrapper.
X_BEARER_TOKEN=
