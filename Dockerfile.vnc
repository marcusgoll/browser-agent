FROM python:3.11-slim

# Install system deps for Playwright/Chromium + VNC + Xvfb
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget curl ca-certificates \
    libnss3 libatk-bridge2.0-0 libxcomposite1 libxdamage1 \
    libxrandr2 libgbm1 libxshmfence1 libasound2 libpangocairo-1.0-0 \
    libgtk-3-0 fonts-liberation libdrm2 libegl1 \
    xvfb x11vnc fluxbox \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps
RUN pip install --no-cache-dir browser-use playwright openai anthropic langchain-openai langchain-anthropic litellm

# Install Playwright browsers
RUN playwright install chromium
RUN playwright install-deps chromium

# Create app directory
WORKDIR /app

# Copy scripts
COPY scripts/ /app/scripts/
COPY tasks/ /app/tasks/

# Persistent browser profiles
VOLUME ["/app/profiles"]
VOLUME ["/app/output"]

ENV PYTHONUNBUFFERED=1
ENV BROWSER_PROFILE_DIR=/app/profiles
ENV OUTPUT_DIR=/app/output
ENV DISPLAY=:99

# VNC port
EXPOSE 5900

# Start Xvfb + VNC + fluxbox, then keep alive
CMD ["sh", "-c", "Xvfb :99 -screen 0 1920x1080x24 & x11vnc -display :99 -nopw -forever & fluxbox & tail -f /dev/null"]
